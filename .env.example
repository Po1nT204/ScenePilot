# From the Supabase project Connect dialog. Never use a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Enable explicitly after checking billing and permissions.
YANDEX_GENERATION_ENABLED=false
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1

# Local video production. Keep real generation disabled until billing is approved.
VIDEO_GENERATION_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
BFL_API_KEY=
# Optional absolute data directory. Default: LocalAppData/ScenePilot/production.
SCENEPILOT_MEDIA_DIR=
# Optional executable paths. Empty means use PATH.
FFMPEG_PATH=
FFPROBE_PATH=
