# From the Supabase project Connect dialog. Never use a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Enable explicitly after checking billing and permissions.
YANDEX_GENERATION_ENABLED=false
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1

# Local video production. Keep real generation disabled until billing is approved.
VIDEO_GENERATION_ENABLED=false
# Key scopes: Text to Speech (Access); connection check: User (Read), Voices (Read).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Optional image modules: select one in Video. No automatic fallback.
# Cloudflare SDXL Beta: currently free; Workers AI token needs Read + Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional paid alternative, not required by Cloudflare or speech-only.
BFL_API_KEY=
# Optional absolute data directory. Default: LocalAppData/ScenePilot/production.
SCENEPILOT_MEDIA_DIR=
# Optional executable paths. Empty means use PATH.
FFMPEG_PATH=
FFPROBE_PATH=
